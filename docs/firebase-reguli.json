{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || (data.child('host').val() === auth.uid && !newData.exists()))",
        "host": { ".validate": "newData.isString()" },
        "created": { ".validate": "newData.isNumber()" },
        "ver": { ".validate": "newData.isString() && newData.val().length < 40" },
        "state": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid",
          ".validate": "newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'over'"
        },
        "opts": { ".write": "auth != null && data.parent().child('host').val() === auth.uid" },
        "start": { ".write": "auth != null && data.parent().child('host').val() === auth.uid && !data.exists()" },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 24"
          }
        },
        "turns": {
          "$n": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms').child($code).child('members').child($uid).exists()",
              ".validate": "newData.isString() && newData.val().length < 10000"
            }
          }
        },
        "ack": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('members').child($uid).exists()",
            ".validate": "newData.isNumber() && (!data.exists() || newData.val() > data.val())"
          }
        },
        "hash": {
          "$n": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists()",
              ".validate": "newData.isString() && newData.val().length < 24"
            }
          }
        },
        "drop": {
          "$uid": {
            ".write": "auth != null && !data.exists() && (auth.uid === $uid || data.parent().parent().child('host').val() === auth.uid)",
            ".validate": "newData.isNumber()"
          }
        },
        "chat": {
          "$id": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
            ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 200"
          }
        }
      }
    }
  }
}
